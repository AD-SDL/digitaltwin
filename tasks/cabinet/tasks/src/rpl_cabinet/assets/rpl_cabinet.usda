#usda 1.0
(
    defaultPrim = "Cabinet"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cabinet" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Scope "Looks"
    {
        def Material "BlackSteel"
        {
            token outputs:surface.connect = </Cabinet/Looks/BlackSteel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.038)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Chrome"
        {
            token outputs:surface.connect = </Cabinet/Looks/Chrome/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.83, 0.85, 0.88)
                float inputs:metallic = 1
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

        def Material "InnerSteel"
        {
            token outputs:surface.connect = </Cabinet/Looks/InnerSteel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.075, 0.075, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

